#!/bin/sh

# Exit on the first failing command; see ./configure.
set -e

RSCRIPT="${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe"

# RcppParallel flags
RCPP_PARALLEL_CPPFLAGS=`"${RSCRIPT}" -e "cat(RcppParallel::CxxFlags())"`
RCPP_PARALLEL_LIBS=`"${RSCRIPT}" -e "cat(RcppParallel::LdFlags())"`

# Generate sources.mk using R (the script writes src/sources.mk itself)
"${RSCRIPT}" inst/generate_makevars_sources.R

# Substitute into Makevars.win
sed -e "s|@RCPP_PARALLEL_CPPFLAGS@|${RCPP_PARALLEL_CPPFLAGS}|" \
    -e "s|@RCPP_PARALLEL_LIBS@|${RCPP_PARALLEL_LIBS}|" \
    src/Makevars.in > src/Makevars.win

# make needs a non-empty object list; check the file, not only the exit status.
if [ ! -s src/sources.mk ]; then
  echo "configure.win: src/sources.mk was not generated; cannot build bgms." >&2
  exit 1
fi
